# Runtime path for Vite build assets
SUITE_BASE_PATH=/standalone/s_tts/

# Optional build stamp shown in built artifact metadata.
VITE_BUILD_STAMP=

# Optional standalone upload host for custom voice file PUT requests.
# Example: https://s-tts.aiunity.shop
# If unset, defaults to current origin.
VITE_STTS_UPLOAD_BASE_URL=
