# Optional build stamp shown in built artifact metadata.
VITE_BUILD_STAMP=

# Optional local override for Vite base path.
# Base path is fixed to relative in vite.config.ts; this variable is ignored.
# SUITE_BASE_PATH is intentionally not used.

# Optional default API base for Kling endpoints used by the frontend tool.
VITE_KLING_API_BASE_URL=https://hk.n1n.ai
