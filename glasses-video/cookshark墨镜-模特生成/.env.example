# Local-only configuration. Copy to .env.local and fill in your key.
GEMINI_API_KEY=your_gemini_api_key

# Image generation endpoint (current app flow)
GEMINI_IMAGE_API_KEY=your_image_api_key
GEMINI_API_BASE_URL=https://147ai.com/
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Video generation service (the source video app's configuration)
ARK_API_KEY=your_video_api_key
ARK_MODEL_ID=doubao-seedance-2-0-fast-260128
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIDEO_PORT=8787
