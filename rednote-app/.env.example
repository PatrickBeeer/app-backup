# rednote-app Node BFF runtime config.
# Copy this to .run/rednote-app.env and fill in TIKHUB_API_TOKEN.
# The .run/ directory is gitignored, so secrets stay local.

# Port the BFF listens on (127.0.0.1 only). app-manager proxies to this.
PORT=9899

# TikHub credentials — server-side only, never shipped to the browser.
TIKHUB_API_TOKEN=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_WEB_NOTE_DETAIL_PATH=/api/v1/xiaohongshu/web_v3/fetch_note_detail
TIKHUB_IMAGE_NOTE_DETAIL_PATH=/api/v1/xiaohongshu/app_v2/get_image_note_detail
TIKHUB_VIDEO_NOTE_DETAIL_PATH=/api/v1/xiaohongshu/app_v2/get_video_note_detail
TIKHUB_NOTE_COMMENTS_PATH=/api/v1/xiaohongshu/app_v2/get_note_comments

# Max bytes for a single media download (cover image or video for frame extraction).
MAX_MEDIA_BYTES=20000000

# Comma-separated banned terms used by the client-side compliance check.
BANNED_TERMS=百分百,绝对有效,保证治愈,全网第一,国家级,点击关注,点赞收藏
