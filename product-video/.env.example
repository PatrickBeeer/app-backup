# Optional remote API origin. Leave empty when the local reverse proxy exposes /api.
VITE_API_BASE_URL=
VITE_GEMINI_PROXY_PATH=/api/gemini/generate
VITE_ASSET_UPLOAD_PATH=/api/assets/upload

# These are read by the local API proxy/server, not exposed to the browser.
# Volcengine Ark API Key for doubao-seedance (video).
ARK_API_KEY=replace-with-your-ark-api-key
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 147ai Gemini relay for text (story scripts) and image (shot frames).
GEMINI_147AI_BASE_URL=https://147ai.com/v1
GEMINI_147AI_TEXT_KEY=replace-with-your-147ai-text-key
GEMINI_147AI_IMAGE_KEY=replace-with-your-147ai-image-key
# Official Kling API Key. The local server sends it as an Authorization Bearer token.
# KLING_API_KEY=replace-with-your-api-key
KLING_API_BASE_URL=https://api-beijing.klingai.com
# ELEVENLABS_API_KEY=replace-with-your-api-key
# Optional overrides for the temporary local reference-video tunnel.
# CLOUDFLARED_PATH=C:/path/to/cloudflared.exe
# KLING_PUBLIC_ASSET_BASE_URL=https://your-own-public-asset-host.example
# JIMENG_ACCESS_KEY=replace-with-your-volcengine-access-key
# JIMENG_SECRET_KEY=replace-with-your-volcengine-secret-key
VITE_KLING_VIDEO_MODEL=kling-3.0
VITE_JIMENG_VIDEO_MODEL=jimeng_i2v_first_v30
