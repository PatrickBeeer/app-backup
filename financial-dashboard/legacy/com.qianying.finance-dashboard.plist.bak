<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.qianying.finance-dashboard</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/qianying/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3</string>
    <string>/Users/qianying/Library/Mobile Documents/com~apple~CloudDocs/财务/server.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/qianying/Library/Mobile Documents/com~apple~CloudDocs/财务</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/qianying/Library/Mobile Documents/com~apple~CloudDocs/财务/logs/finance-dashboard.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/qianying/Library/Mobile Documents/com~apple~CloudDocs/财务/logs/finance-dashboard.err.log</string>
</dict>
</plist>
