        f"\n上下文：{json.dumps(context, ensure_ascii=False)}"
    )
    return normalize_ai_entries(call_gemini_json([{"text": prompt}]), "ai-text")


def call_gemini_json(parts: list[dict]) -> dict:
    key = gemini_api_key()
    if not key:
        return {"entries": []}
    model = os.environ.get("GEMINI_MODEL", DEFAULT_GEMINI_MODEL).strip() or DEFAULT_GEMINI_MODEL
    payload = {
        "contents": [{"role": "user", "parts": parts}],
        "generationConfig": {
            "temperature": 0,
            "responseMimeType": "application/json",
        },
    }
    data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    request = urllib.request.Request(
        f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={key}",
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            raw = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="ignore")
        raise AiRecognitionError(redact_secrets(f"Gemini识别服务返回 {exc.code}：{detail}")[:500]) from exc
    except Exception as exc:
        raise AiRecognitionError(redact_secrets(f"Gemini识别服务调用失败：{exc}")[:500]) from exc
    try:
        content = "".join(part.get("text", "") for part in raw["candidates"][0]["content"]["parts"])
        return parse_json_object(content)
    except Exception as exc:
        raise AiRecognitionError("Gemini识别结果不是可读取的 JSON。") from exc


def call_openai_json(prompt: str) -> dict:
    key = openai_api_key()
    if not key:
        return {}
    payload = {
        "model": os.environ.get("OPENAI_MODEL", DEFAULT_OPENAI_MODEL).strip() or DEFAULT_OPENAI_MODEL,
        "messages": [
            {"role": "user", "content": prompt},
        ],
        "temperature": 0,
        "response_format": {"type": "json_object"},
    }
    data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    request = urllib.request.Request(
        "https://api.openai.com/v1/chat/completions",
        data=data,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=45) as response:
            raw = json.loads(response.read().decode("utf-8"))
            return parse_json_object(raw["choices"][0]["message"]["content"])
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="ignore")
        raise AiRecognitionError(redact_secrets(f"OpenAI修改服务返回 {exc.code}：{detail}")[:500]) from exc
    except Exception as exc:
        raise AiRecognitionError(redact_secrets(f"OpenAI修改服务调用失败：{exc}")[:500]) from exc


def allowed_categories() -> list[str]:
    return [
        "线下课营收",
        "课程营收",
        "企业培训",
        "工资成本",
        "社保成本",
        "佣金支付",
        "投放费用",
        "报销及杂项",
        "办公固定成本",
        "技术/录播费用",
        "退款",
        "调整",
        "未分类成本",
    ]


def image_data_url(path: Path) -> str:
    mime_type = image_mime_type(path)
    encoded = base64.b64encode(path.read_bytes()).decode("ascii")
    return f"data:{mime_type};base64,{encoded}"


def image_mime_type(path: Path) -> str:
    return mimetypes.guess_type(path.name)[0] or "image/png"


def text_source_ref(month_id: str, text: str) -> str:
    digest = hashlib.sha1(f"{month_id}\n{text}".encode("utf-8")).hexdigest()[:16]
    return f"text-{digest}"


def workbook_sample(workbook) -> dict:
    sheets = []
    for sheet in workbook.worksheets[:8]:
        rows = []
        for row in range(1, min(sheet.max_row, 35) + 1):
            values = [safe_cell_value(sheet.cell(row, col).value) for col in range(1, min(sheet.max_column, 16) + 1)]
            if any(value not in {"", None} for value in values):
                rows.append(values)
            if len(rows) >= 24:
                break
        sheets.append(
            {
                "name": sheet.title,
                "rows": sheet.max_row,
                "columns": sheet.max_column,
                "sampleRows": rows,
            }
        )
    return {"sheets": sheets}


def safe_cell_value(value):
    if value is None:
        return ""
    if isinstance(value, datetime):
        return value.strftime("%Y-%m-%d")
    if isinstance(value, (int, float)):
        return value
    text = clean_text(value)
    return text[:120]


def parse_json_object(content: str) -> dict:
    text = content.strip()
    if text.startswith("```"):
        text = re.sub(r"^```(?:json)?\s*", "", text)
        text = re.sub(r"\s*```$", "", text)
    return json.loads(text)


def normalize_ai_entries(result: dict, source_kind: str = "ai") -> list[dict]:
    entries = []
    if not isinstance(result, dict):
        return entries
    for item in result.get("entries", []):
        if not isinstance(item, dict):
            continue
        entry_type = clean_text(item.get("type"))
        if entry_type not in {"income", "expense", "refund", "adjustment"}:
            continue
        amount = to_number(item.get("amount"))
        if amount is None or amount == 0:
            continue
        category = clean_text(item.get("category")) or ("退款" if entry_type == "refund" else "未分类成本")
        if entry_type == "expense":
            category = normalize_cost_category(category, clean_text(item.get("name")))
            amount = abs(amount)
        elif entry_type == "refund":
            category = "退款"
            amount = -abs(amount)
        else:
            amount = abs(amount)
        entries.append(
            {
                "name": clean_text(item.get("name")) or category,
                "amount": round(amount, 2),
                "type": entry_type,
                "category": category,
                "sourceKind": source_kind,
                "note": clean_text(item.get("note")),
            }
        )
    return entries


def find_generic_header(sheet):
    for row in range(1, min(sheet.max_row, 25) + 1):
        columns = {}
        for col in range(1, sheet.max_column + 1):
            value = clean_text(sheet.cell(row, col).value)
            if not value:
                continue
            normalized = normalize_header(value)
            if any(key in normalized for key in ["金额", "价格", "合计", "工资", "费用", "成本"]):
                columns.setdefault("amount", col)
                columns[value] = col
            elif any(key in normalized for key in ["姓名", "名字", "名称", "项目"]):
                columns.setdefault("name", col)
                columns[value] = col
            elif any(key in normalized for key in ["日期", "时间"]):
                columns.setdefault("date", col)
                columns[value] = col
            else:
                columns[value] = col
        if "amount" in columns and ("name" in columns or len(columns) >= 3):
            return row, columns
    return None


def choose_amount_column(columns: dict, parse_hint: str):
    normalized_hint = normalize_header(parse_hint)
    for label, col in columns.items():
        if label in {"amount", "name", "date"}:
            continue
        if normalize_header(label) and normalize_header(label) in normalized_hint:
            return col
    return columns.get("amount")


def choose_name_column(columns: dict):
    return columns.get("name")


def choose_date_column(columns: dict):
    return columns.get("date")


def hint_mode(parse_hint: str) -> str:
    if any(word in parse_hint for word in ["退款", "退费"]):
        return "refund"
    if any(word in parse_hint for word in ["收入", "营收", "成交", "付款", "销售"]):
        return "income"
    if any(word in parse_hint for word in ["工资", "成本", "支出", "费用", "报销"]):
        return "expense"
    return ""


def hint_category(parse_hint: str, mode: str) -> str:
    if "工资" in parse_hint:
        return "工资成本"
    if "佣金" in parse_hint:
        return "佣金支付"
    if "投放" in parse_hint:
        return "投放费用"
    if "报销" in parse_hint or "杂项" in parse_hint:
        return "报销及杂项"
    if "成交" in parse_hint or "学员" in parse_hint or "线下课" in parse_hint:
        return "线下课营收"
    return "收入" if mode == "income" else "费用"


def header_matches(value: str, aliases: set[str]) -> bool:
    normalized = normalize_header(value)
    return any(normalized == normalize_header(alias) or normalize_header(alias) in normalized for alias in aliases)


def normalize_header(value: str) -> str:
    return re.sub(r"\s+", "", value).replace("、", "").replace("/", "")


def row_matches_enrollment_month(month_id: str, payment_time: str, course_date: str, note_values: list[str]) -> bool:
    target_month = int(month_id.split("-")[1])
    payment_months = extract_month_numbers(clean_text(payment_time))
    if payment_months:
        return target_month in payment_months
    course_months = extract_month_numbers(clean_text(course_date))
    if course_months:
        return target_month in course_months

    haystack = " ".join(clean_text(value) for value in note_values if clean_text(value))
    if not haystack:
        return False
    if contains_chinese_month(haystack, target_month):
        return True
    return any(month == target_month for month in extract_month_numbers(haystack))


def contains_chinese_month(text: str, month: int) -> bool:
    chinese = {
        1: "一",
        2: "二",
        3: "三",
        4: "四",
        5: "五",
        6: "六",
        7: "七",
        8: "八",
        9: "九",
        10: "十",
        11: "十一",
        12: "十二",
    }
    return f"{month}月" in text or f"{chinese[month]}月" in text


def extract_month_numbers(text: str) -> list[int]:
    months: list[int] = []
    numeric_month = excel_serial_month(text)
    if numeric_month:
        months.append(numeric_month)
    for match in re.finditer(r"(?:20)?\d{2}[./-](1[0-2]|0?[1-9])(?:[./-]\d{1,2})?", text):
        months.append(int(match.group(1)))
    for match in re.finditer(r"(?<!\d)(1[0-2]|0?[1-9])[./-]\d{1,2}(?!\d)", text):
        months.append(int(match.group(1)))
    return months


def excel_serial_month(value: str) -> int | None:
    text = clean_text(value)
    if not re.fullmatch(r"\d+(?:\.\d+)?", text):
        return None
    serial = float(text)
    if serial < 30000:
        return None
    try:
        return from_excel(serial).month
    except Exception:
        return None


def merge_existing_entries(existing: dict | None, entries: list[dict], parsed_kind: str) -> list[dict]:
    if not existing:
        return entries
    existing_entries = existing.get("entries", [])
    if parsed_kind == "detail":
        kept = [entry for entry in existing_entries if entry.get("sourceKind") == "manual"]
    elif parsed_kind == "salary":
        kept = [
            entry
            for entry in existing_entries
            if not (entry.get("sourceKind") == "salary" or (entry.get("category") == "工资成本" and str(entry.get("name", "")).endswith("工资")))
        ]
    elif parsed_kind == "enrollment":
        kept = [
            entry
            for entry in existing_entries
            if not (entry.get("sourceKind") == "enrollment" or entry.get("category") in {"线下课营收"})
        ]
    elif parsed_kind == "ai":
        kept = [entry for entry in existing_entries if entry.get("sourceKind") != "ai"]
    else:
        kept = existing_entries
    return kept + entries


def normalize_entry_type(raw_category: str, amount: float) -> str:
    if "退款" in raw_category or amount < 0:
        return "refund"
    if "调整" in raw_category:
        return "adjustment"
    return "income"


def normalize_income_category(raw_category: str, name: str) -> str:
    text = f"{raw_category} {name}"
    if "培训" in text or "企业" in text:
        return "企业培训"
    if "退款" in text:
        return "退款"
    if "调整" in text:
        return "调整"
    if raw_category and raw_category != "营收":
        return raw_category
    return "课程营收"


def normalize_cost_category(raw_category: str, name: str) -> str:
    text = f"{raw_category} {name}"
    rules = [
        ("工资成本", ["工资", "薪资", "薪酬"]),
        ("社保成本", ["社保", "公积金"]),
        ("佣金支付", ["佣金", "分佣"]),
        ("投放费用", ["投放", "千川", "广告", "视频号"]),
        ("报销及杂项", ["报销", "杂项", "差旅", "餐", "办公用品"]),
        ("办公固定成本", ["房租", "网", "电", "手机", "物业"]),
        ("技术/录播费用", ["录播", "技术", "软件", "系统"]),
    ]
    for category, keywords in rules:
        if any(keyword in text for keyword in keywords):
            return category
    return raw_category or "未分类成本"


def build_notes(entries: list[dict]) -> list[dict]:
    expense_categories = sorted({entry["category"] for entry in entries if entry["type"] == "expense"})
    notes = [
        {"title": "数据来源", "text": "本月数据由上传表格解析和手动录入共同生成。" if any(entry.get("sourceKind") == "manual" for entry in entries) else "本月数据由上传表格自动解析生成。"},
        {"title": "成本分类", "text": "已识别：" + "、".join(expense_categories) if expense_categories else "暂无成本分类。"},
        {"title": "口径提示", "text": "净营收 = 收入 + 退款/调整；实际净利润 = 净营收 - 总支出。"},
    ]
    if any(str(entry.get("sourceKind", "")).startswith("ai") for entry in entries):
        notes.insert(1, {"title": "AI辅助识别", "text": "本月使用大模型进行了辅助解析，请重点核对金额、月份和分类。"})
    return notes


def update_manifest(month_path: str) -> None:
    if MANIFEST_PATH.exists():
        manifest = json.loads(MANIFEST_PATH.read_text(encoding="utf-8"))
    else:
        manifest = {"months": []}
    months = set(manifest.get("months", []))
    months.add(month_path)
    manifest["months"] = sorted(months, reverse=True)
    MANIFEST_PATH.write_text(json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8")
    sync_embedded_data(manifest)


def sync_embedded_data(manifest: dict | None = None) -> None:
    if manifest is None:
        if not MANIFEST_PATH.exists():
            manifest = {"months": []}
        else:
            manifest = json.loads(MANIFEST_PATH.read_text(encoding="utf-8"))
    loaded_months = []
    for month_path in manifest.get("months", []):
        path = ROOT / month_path
        if path.exists():
            loaded_months.append(json.loads(path.read_text(encoding="utf-8")))
    payload = json.dumps({"manifest": manifest, "months": loaded_months}, ensure_ascii=False, indent=2)
    escaped_payload = payload.replace("<", "\\u003c")
    EMBEDDED_DATA_PATH.write_text(
        f"window.__FINANCE_DASHBOARD_DATA__ = {escaped_payload};\n",
        encoding="utf-8",
    )


def load_existing_month(month_id: str) -> dict | None:
    path = MONTHS_DIR / f"{month_id}.json"
    if not path.exists():
        return None
    return json.loads(path.read_text(encoding="utf-8"))


def load_local_env() -> None:
    global _ENV_LOADED
    if _ENV_LOADED:
        return
    _ENV_LOADED = True
    if not ENV_PATH.exists():
        return
    for line in ENV_PATH.read_text(encoding="utf-8").splitlines():
        text = line.strip()
        if not text or text.startswith("#") or "=" not in text:
            continue
        key, value = text.split("=", 1)
        key = key.strip()
        value = value.strip().strip("\"'")
        if key and key not in os.environ:
            os.environ[key] = value


def openai_api_key() -> str:
    load_local_env()
    return os.environ.get("OPENAI_API_KEY", "").strip()


def gemini_api_key() -> str:
    load_local_env()
    return os.environ.get("GEMINI_API_KEY", "").strip()


def ai_api_available() -> bool:
    return bool(gemini_api_key() or openai_api_key())


def redact_secrets(text: str) -> str:
    text = re.sub(r"sk-[A-Za-z0-9_\-]+", "sk-***", text)
    return re.sub(r"AIza[0-9A-Za-z_\-]+", "AIza***", text)


def merge_note(notes: list[dict], next_note: dict) -> list[dict]:
    filtered = [note for note in notes if note.get("title") != next_note["title"]]
    return [next_note, *filtered]


def upload_relative_path(path: Path) -> str:
    return path.resolve().relative_to(ROOT).as_posix()


def read_cell(sheet, cell: str) -> str:
    if sheet is None:
        return ""
    return clean_text(sheet[cell].value)


def clean_text(value) -> str:
    if value is None:
        return ""
    return str(value).strip()


def to_number(value) -> float | None:
    if value is None or value == "":
        return None
    if isinstance(value, (int, float)):
        return float(value)
    text = str(value).replace(",", "").replace("¥", "").replace("￥", "").strip()
    if not text:
        return None
    try:
        return float(text)
    except ValueError:
        return None


def format_amount(value: float) -> str:
    if float(value).is_integer():
        return f"{int(value):,}"
    return f"{value:,.2f}"


def sanitize_filename(filename: str) -> str:
    name = Path(filename).name
    return re.sub(r"[^0-9A-Za-z._\-\u4e00-\u9fff]+", "_", name)


def month_label(month_id: str) -> str:
    year, month = month_id.split("-")
    return f"{year}年{int(month)}月"


if __name__ == "__main__":
    mimetypes.add_type("text/javascript; charset=utf-8", ".js")
    sync_embedded_data()
    server = ThreadingHTTPServer(("127.0.0.1", 5173), FinanceHandler)
    print("财务驾驶舱已启动：http://127.0.0.1:5173/")
    server.serve_forever()
