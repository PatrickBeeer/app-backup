PORT=3013
DEMO_MODE=true
DATA_DIR=./data

# 视频生成：智算谷 CPRT（本应用直接持有 Key 调用，不经过 app-manager）
CPRT_BASE_URL=https://ai-api.cprt.xyz
CPRT_API_KEY=
CPRT_VIDEO_MODEL=free-video-2.0-multimodal-video
CPRT_FALLBACK_MODEL=free-video-2.0-image-to-video

# 口播改写：DeepSeek（本应用直接持有 Key 调用，不经过 app-manager）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 本地 Whisper ASR
LOCAL_ASR_ENABLED=true
WHISPER_MODEL=onnx-community/whisper-small

# 素材发布：经 app-manager → api-manager → COS presign 上传。
# 凭证由 api-manager 服务端持有（cos_setting.cam_api_key / cos_setting.bucket），
# 本应用不需要任何 COS_* 配置。
PLATFORM_GATEWAY_ORIGIN=http://127.0.0.1:80
STANDALONE_APP_ID=live-commerce-replica

# 计费：经 user-manager 扣费（本应用直接调用 CPRT/DeepSeek，不走 api-manager 计费管线）
USER_MANAGER_ORIGIN=http://127.0.0.1:3003
VIDEO_COST_PER_SECOND=15
# 兼容卖点可视化应用中的 Seedance 每秒计费变量名；若设置，也会被读取。
# SEEDANCE_VIDEO_PER_SECOND=15
# SEEDANCE_VIDEO_COST_PER_SECOND=15

# 可选：当本服务已通过反向代理或隧道暴露在公网时，可直接拼公网 URL 跳过 COS 上传。
# 留空则默认走 PLATFORM_GATEWAY_ORIGIN 的 COS presign 路径。
MEDIA_PUBLIC_BASE_URL=

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Linux 默认；容器需安装 fonts-wqy-microhei 或 fonts-noto-cjk
SUBTITLE_FONT_FILE=/usr/share/fonts/truetype/wqy/wqy-microhei.ttc
